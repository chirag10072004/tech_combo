# Tech Combo Backend Environment Configuration

# Server Port
PORT=5000

# OPTION 1: Resend API Key (Recommended for Cloud Hosting like Render/Vercel)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_123456789...

# OPTION 2: Gmail SMTP Credentials (Alternative)
# Generate a 16-character App Password from your Google Account settings
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Target email to receive form submissions (Contact & Job Applications)
EMAIL_RECEIVER=cloudstorageforphotos01@gmail.com

# Displayed Sender Email / From Header
EMAIL_FROM=cloudstorageforphotos01@gmail.com

# Enable or disable auto-reply emails to user (true/false)
SEND_AUTO_REPLY=true
